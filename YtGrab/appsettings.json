{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Downloader": {
    "MaxConcurrentJobs": 2,
    "MaxQueuedJobs": 50,
    "MaxDurationMinutes": 120,
    "MaxFileSizeMb": 2048,
    "FileRetentionMinutes": 30,
    "JobTimeoutMinutes": 20,
    "InfoTimeoutSeconds": 45,
    "AutoUpdateYtDlp": true,
    "CookiesFile": "",
    "Proxy": ""
  }
}